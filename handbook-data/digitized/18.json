      "box": {
        "height": 0.025841408409178257,
        "width": 0.46739415327707934,
        "x": 0.22454829330647427,
        "y": 0.17769623113840338
      },
      "level": 0.18066531358330962
    },
    {
      "text": "three grading periods, he/she may be a candidate for honors to be awarded",
      "box": {
        "height": 0.021995366550982,
        "width": 0.46705424785614014,
        "x": 0.22480621712490123,
        "y": 0.1904069774974141
      },
      "level": 0.1904069774974141
    },
    {
      "text": "during the recognition rites or he/she may be declared as Achiever.",
