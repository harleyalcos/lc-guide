  "rows": [
    {
      "text": "The school's anti-bullying policy also prohibits retaliation",
      "box": {
        "height": 0.04928930848836899,
        "width": 0.45088716348012287,
        "x": 0.27030969534311805,
        "y": 0.2143298148000511
      },
      "level": 0.21189362267206932
    },
    {
      "text": "against a person who reports bullying, who provides",
      "box": {
        "height": 0.045326024293899536,
        "width": 0.48325113455454505,
        "x": 0.23759951247708141,
        "y": 0.2297171310953512
      },
      "level": 0.22830082209551528
    },
    {
      "text": "information during an investigation or who is a witness to or",
      "box": {
        "height": 0.04573996365070343,
        "width": 0.4909809033075969,
        "x": 0.2317824214574055,
        "y": 0.2442584731238634
      },
      "level": 0.24302047088341996
    },
    {
      "text": "has reliable information about any bullying incident.",
      "box": {
        "height": 0.0298332367092371,
        "width": 0.41031086444854736,
        "x": 0.23396733311676887,
        "y": 0.2640688566225253
      },
      "level": 0.26279480811790246
    },
    {
