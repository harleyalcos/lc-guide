        "x": 0.25551559774495375,
        "y": 0.5621336249691593
      },
      "level": 0.5681835073619772
    },
    {
      "text": "Student leaders are responsible, and are subject to",
      "box": {
        "height": 0.011866370216012001,
        "width": 0.19573642810185748,
        "x": 0.4069767504516551,
        "y": 0.5813953487135192
      },
      "level": 0.5831112958036506
