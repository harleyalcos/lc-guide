  "rows": [
    {
      "text": "A student is no longer retained in a course if he/she fails to meet the",
      "box": {
        "height": 0.02490234375,
        "width": 0.4224806229273479,
        "x": 0.2170542664045431,
        "y": 0.23828124972613574
      },
      "level": 0.23828124972613574
    },
    {
      "text": "minimum course requirements.",
      "box": {
        "height": 0.025498028844594955,
        "width": 0.19181944926579797,
        "x": 0.1867632128558513,
        "y": 0.2516899407309543
      },
      "level": 0.2645192292220022
    },
    {
      "text": "A student who does not pass at least 50% of all the registered units",
      "box": {
        "height": 0.021802324801683426,
        "width": 0.42441860834757494,
        "x": 0.21511628146574738,
        "y": 0.2688953492997397
      },
      "level": 0.2688953492997397
    },
    {
      "text": "within the semester is placed under probation for another semester or may",
      "box": {
        "height": 0.023255813866853714,
        "width": 0.4534883499145508,
        "x": 0.18604652649621292,
        "y": 0.28052325590572047
      },
      "level": 0.28052325590572047
    },
    {
      "text": "be asked to shift to another course.",
      "box": {
        "height": 0.024712136015295982,
        "width": 0.21671122312545782,
        "x": 0.18297122796959597,
        "y": 0.2918389411629151
      },
      "level": 0.3046381351000137
    },
    {
      "text": "If in the succeeding semester, the student still does not pass at least",
      "box": {
        "height": 0.02197265625,
        "width": 0.4302325646082561,
        "x": 0.211240312172616,
        "y": 0.3110351566741397
      },
      "level": 0.3110351566741397
    },
    {
      "text": "50% of all the registered units, he/she is not entitled to re-enrolment.",
