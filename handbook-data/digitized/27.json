        "x": 0.20473288107000887,
        "y": 0.6573343128268848
      },
      "level": 0.6735646710290085
    },
    {
      "text": "the corridors during class hours.",
      "box": {
        "height": 0.01904296875,
        "width": 0.2674418489138286,
        "x": 0.16860465848882214,
        "y": 0.6845703129174892
      },
      "level": 0.6842939780434216
    },
    {
      "text": "Section 2. Students shall keep to the right when walking in the",
      "box": {
        "height": 0.03427025489509106,
        "width": 0.5285815000534058,
