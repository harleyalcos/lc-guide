    {
      "text": "responsible citizens, fully dedicated to the creation of a just,",
      "box": {
        "height": 0.02612587809562683,
        "width": 0.5179589986801147,
        "x": 0.22257697506676286,
        "y": 0.6645152781260485
      },
      "level": 0.6724356387843663
    },
    {
      "text": "humane and caring society that fears God, protects the",
      "box": {
        "height": 0.01904296875,
        "width": 0.5174418687820435,
