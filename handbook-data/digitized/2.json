    {
      "text": "II. The Mission of the Laguna College",
      "box": {
        "height": 0.02078234124928713,
        "width": 0.32999447981516516,
        "x": 0.2884771456706203,
        "y": 0.5006070660418842
      },
      "level": 0.5047273684284661
    },
    {
      "text": "Laguna College does its best to impart and promote",
      "box": {
        "height": 0.021106011234223843,
        "width": 0.4733089208602906,
        "x": 0.25556359690980096,
        "y": 0.5228233278482537
      },
      "level": 0.5281180396429579
